{
  "expo": {
    "name": "Freelance Ops",
    "slug": "freelance-ops",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "freelanceops",
    "userInterfaceStyle": "automatic",
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.jonathansalgadonieto.freelanceops"
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
